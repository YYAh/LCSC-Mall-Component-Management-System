/* pages/settings/settings.wxss */
.setting-desc {
  font-size: 24rpx;
  color: #8c8c8c;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.free-features-box {
  background: #f6ffed;
  border: 1px solid #b7eb8f;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  margin-top: 10rpx;
}

.free-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #389e0d;
  margin-bottom: 12rpx;
}

.free-item {
  font-size: 24rpx;
  color: #237804;
  line-height: 1.6;
  margin-bottom: 10rpx;
}

.font-bold {
  font-weight: 700;
}

.status-indicator {
  font-size: 22rpx;
  font-weight: normal;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.status-indicator.online {
  background: #f6ffed;
  color: #52c41a;
  border: 1px solid #b7eb8f;
}

.demo-btn {
  width: 100%;
  margin-top: 10rpx;
  background: #e6f7ff;
  color: #1890ff;
  border: 1px solid #91d5ff;
}

/* About Items */
.about-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1px solid #f0f0f0;
  font-size: 26rpx;
}

.about-item:last-child {
  border-bottom: none;
}

.about-label {
  color: #8c8c8c;
}

.about-val {
  color: #262626;
  font-weight: 500;
}
