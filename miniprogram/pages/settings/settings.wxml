<!-- pages/settings/settings.wxml -->
<view class="container">
  <!-- Storage Architecture -->
  <view class="card">
    <view class="card-title">
      <text>📱 运行架构与数据存储</text>
      <view class="status-indicator online">
        ● 100% 永久免费单机
      </view>
    </view>

    <!-- Zero-Fee Backup & Import Banner -->
    <view class="free-features-box">
      <view class="free-title">🎉 纯本地单机特色：</view>
      <view class="free-item">✅ 零服务器成本、零云开发月费，全部数据安全保存在手机微信本地；</view>
      <view class="free-item">✅ 内置全套阻容/芯片/品牌智能解码引擎，离线秒级自动识别真实阻值、原厂品牌与封装；</view>
      <view class="free-item">✅ 支持从微信直接选取 .xlsx / .csv 表格一键导入导出，全自动分配样品册插槽！</view>
    </view>
  </view>

  <!-- Demo Data & Quick Setup -->
  <view class="card">
    <view class="card-title">
      <text>📦 示例数据与快速体验</text>
    </view>
    <view class="setting-desc">
      <text>一键向样品册中写入常用的轻触开关（C127509）、首韩拨码开关、TF卡座、贴片电阻（FRC0603 100Ω/100kΩ）等真实嘉立创物料数据，立即体验 12 行插槽可视化与库存管理。</text>
    </view>
    <button class="btn-secondary demo-btn" bindtap="seedDemoData" loading="{{seeding}}">
      🚀 写入嘉立创常用元器件示例数据
    </button>
    <button class="btn-danger-outline demo-btn" style="margin-top: 16rpx;" bindtap="clearAllData">
      ⚠️ 清空本地全部物料与测试数据
    </button>
  </view>

  <!-- About System -->
  <view class="footer-about">
    <view>嘉立创元器件与 12 行样品册管理系统 v3.8</view>
    <view>100% 永久免费 · 纯本地离线单机 · Excel/XLSX 导入导出</view>
  </view>
</view>
