/* pages/index/index.wxss */
.header-card {
  background: linear-gradient(135deg, #1890ff, #0050b3);
  border-radius: 20rpx;
  padding: 32rpx;
  color: #ffffff;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.25);
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 36rpx;
}

.header-title {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.header-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 6rpx;
}

.server-status {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.2);
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.server-status.online .status-dot {
  background: #52c41a;
  box-shadow: 0 0 8rpx #52c41a;
}

.server-status.offline .status-dot {
  background: #f5222d;
}

/* KPI Grid */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  text-align: center;
}

.kpi-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.kpi-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.kpi-item.warning .kpi-num {
  color: #ff4d4f;
  text-shadow: 0 0 10rpx rgba(255, 77, 79, 0.6);
}

.kpi-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}

/* Action Grid */
.action-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.action-btn {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.action-btn:active {
  transform: scale(0.98);
}

.action-icon {
  font-size: 48rpx;
  margin-right: 18rpx;
}

.action-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.action-desc {
  font-size: 22rpx;
  color: #8c8c8c;
  margin-top: 4rpx;
}

/* Low Stock */
.more-link {
  font-size: 24rpx;
  color: #1890ff;
  font-weight: normal;
}

.low-stock-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1px solid #f0f0f0;
}

.low-stock-item:last-child {
  border-bottom: none;
}

.low-stock-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.name-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #262626;
}

.low-stock-loc {
  font-size: 22rpx;
  color: #8c8c8c;
  margin-top: 4rpx;
}

.current-stock {
  font-size: 32rpx;
  font-weight: 700;
  color: #f5222d;
}

.safe-stock {
  font-size: 22rpx;
  color: #bfbfbf;
}

/* Log List */
.log-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1px solid #f0f0f0;
}

.log-item:last-child {
  border-bottom: none;
}

.log-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 16rpx;
  margin-top: 4rpx;
  font-weight: 600;
}

.log-tag.in {
  background: #f6ffed;
  color: #52c41a;
  border: 1px solid #b7eb8f;
}

.log-tag.out {
  background: #fff1f0;
  color: #f5222d;
  border: 1px solid #ffa39e;
}

.log-tag.adjust {
  background: #e6f7ff;
  color: #1890ff;
  border: 1px solid #91d5ff;
}

.log-content {
  flex: 1;
}

.log-title {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  font-weight: 500;
}

.log-comp-name {
  color: #262626;
}

.log-qty {
  font-weight: 700;
}

.text-green {
  color: #52c41a;
}

.text-red {
  color: #f5222d;
}

.log-sub {
  font-size: 22rpx;
  color: #8c8c8c;
  margin-top: 4rpx;
  display: flex;
  justify-content: space-between;
}
