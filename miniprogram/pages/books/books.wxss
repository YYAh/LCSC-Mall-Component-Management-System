/* pages/books/books.wxss */
.book-header-card {
  margin-bottom: 20rpx;
}

.book-select-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
  gap: 12rpx;
}

.book-picker {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.container-type-badge {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.badge-box {
  background: #fef3c7;
  color: #d97706;
  border: 1px solid #fde68a;
}

.badge-book {
  background: #eff6ff;
  color: #2563eb;
  border: 1px solid #bfdbfe;
}

.book-name-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.picker-arrow {
  font-size: 24rpx;
  color: #1890ff;
}

.book-action-btns {
  display: flex;
  gap: 12rpx;
}

.add-book-btn {
  background: #e6f7ff;
  color: #1890ff;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  margin: 0;
  line-height: 1.4;
  border: 1px solid #91d5ff;
}

.del-book-btn {
  background: #fff1f0;
  color: #f5222d;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  margin: 0;
  line-height: 1.4;
  border: 1px solid #ffa39e;
}

.book-metrics {
  display: flex;
  justify-content: space-between;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  text-align: center;
}

.metric-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.metric-val {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
}

.metric-lbl {
  font-size: 20rpx;
  color: #8c8c8c;
  margin-top: 4rpx;
}

.text-green { color: #52c41a; }
.text-blue { color: #1890ff; }

/* ============================================== */
/* X*X Component Box 2D Grid Styles               */
/* ============================================== */
.box-grid-card {
  padding: 20rpx 16rpx;
  margin-bottom: 30rpx;
}

.page-title-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #475569;
  padding: 0 8rpx 16rpx 8rpx;
  border-bottom: 2px solid #f1f5f9;
  margin-bottom: 16rpx;
}

.banner-title-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.banner-icon {
  font-size: 28rpx;
}

.banner-tip {
  font-size: 20rpx;
  color: #3b82f6;
  font-weight: normal;
}

.box-grid-matrix {
  display: grid;
  gap: 12rpx;
  width: 100%;
}

.drawer-cell {
  position: relative;
  border-radius: 12rpx;
  padding: 12rpx 8rpx 10rpx 8rpx;
  min-height: 128rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
  transition: all 0.2s;
}

.drawer-cell.occupied {
  background: #ffffff;
  border: 1.5px solid #93c5fd;
  box-shadow: 0 2rpx 6rpx rgba(37, 99, 235, 0.08);
}

.drawer-cell.occupied:active {
  background: #eff6ff;
}

.drawer-cell.empty {
  background: #f8fafc;
  border: 1.5px dashed #cbd5e1;
}

.drawer-cell.empty:active {
  background: #ecfdf5;
  border-color: #10b981;
}

.drawer-coord-badge {
  font-size: 18rpx;
  font-weight: 700;
  color: #1d4ed8;
  background: #dbeafe;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  display: inline-block;
  align-self: flex-start;
}

.empty-coord {
  background: #e2e8f0;
  color: #64748b;
}

.drawer-comp-mpn {
  font-size: 22rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.25;
  margin-top: 6rpx;
  word-break: break-all;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.drawer-comp-sub {
  font-size: 18rpx;
  color: #64748b;
  margin-top: 2rpx;
  word-break: break-all;
}

.drawer-stock-badge {
  display: flex;
  justify-content: flex-end;
  align-items: baseline;
  gap: 2rpx;
  margin-top: 4rpx;
}

.stock-num {
  font-size: 24rpx;
  font-weight: 800;
  color: #2563eb;
}

.stock-unit {
  font-size: 18rpx;
  color: #94a3b8;
}

.empty-cell-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
}

.empty-plus-icon {
  font-size: 32rpx;
  color: #94a3b8;
  font-weight: bold;
  line-height: 1;
}

.empty-text {
  font-size: 18rpx;
  color: #94a3b8;
  margin-top: 2rpx;
}

/* ============================================== */
/* Sample Book Page View Styles                   */
/* ============================================== */
.page-navigator {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.nav-arrow-btn {
  background: #f0f2f5;
  color: #262626;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  margin: 0;
  line-height: 1.4;
}

.page-current-tag {
  text-align: center;
}

.page-badge {
  font-size: 30rpx;
  font-weight: 700;
  color: #1890ff;
  display: block;
}

.page-sub {
  font-size: 20rpx;
  color: #8c8c8c;
}

.sample-book-page {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.slots-container {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.slot-row {
  display: flex;
  align-items: center;
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  transition: background-color 0.2s;
}

.slot-row.occupied {
  background: #fcfdfe;
  border: 1px solid #e8e8e8;
}

.slot-row.occupied:active {
  background: #e6f7ff;
}

.slot-row.empty {
  background: #fafafa;
  border: 1px dashed #d9d9d9;
}

.slot-row.empty:active {
  background: #f6ffed;
  border-color: #52c41a;
}

.row-index-badge {
  background: #1890ff;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  margin-right: 14rpx;
  min-width: 44rpx;
  text-align: center;
}

.empty-badge {
  background: #d9d9d9;
  color: #595959;
}

.row-thumb {
  width: 68rpx;
  height: 68rpx;
  background: #f0f2f5;
  border-radius: 6rpx;
  margin-right: 14rpx;
}

.row-info {
  flex: 1;
  overflow: hidden;
}

.row-top-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.badge-category-mini {
  background: #f6ffed;
  color: #52c41a;
  border: 1px solid #b7eb8f;
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  white-space: nowrap;
}

.badge-c-code {
  background: #e6f7ff;
  color: #1890ff;
  border: 1px solid #91d5ff;
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  font-weight: 700;
}

.row-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #262626;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.row-sub-line {
  font-size: 22rpx;
  color: #8c8c8c;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.row-spec {
  color: #595959;
}

.row-stock-box {
  text-align: right;
  padding-left: 12rpx;
}

.row-stock-num {
  font-size: 30rpx;
  font-weight: 700;
  color: #1890ff;
}

.row-stock-unit {
  font-size: 20rpx;
  color: #8c8c8c;
  margin-left: 4rpx;
}

.empty-slot-content {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #8c8c8c;
  font-size: 24rpx;
  padding: 10rpx 0;
}

.empty-plus {
  font-size: 32rpx;
  font-weight: 700;
  color: #52c41a;
}

/* ============================================== */
/* Modal Form Styles                              */
/* ============================================== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
  padding: 30rpx;
}

.modal-card {
  background: #ffffff;
  border-radius: 20rpx;
  width: 100%;
  max-width: 650rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #f8fafc;
  border-bottom: 1px solid #e2e8f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.modal-close {
  font-size: 36rpx;
  color: #94a3b8;
  padding: 6rpx;
}

.modal-body {
  padding: 30rpx;
  max-height: 70vh;
  overflow-y: auto;
}

.type-selector-tabs {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.type-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 10rpx;
  background: #f1f5f9;
  border: 1.5px solid #cbd5e1;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #475569;
}

.type-tab.active {
  background: #eff6ff;
  border-color: #2563eb;
  color: #1d4ed8;
  box-shadow: 0 2rpx 8rpx rgba(37, 99, 235, 0.15);
}

.form-item {
  margin-bottom: 22rpx;
}

.form-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #334155;
  margin-bottom: 8rpx;
}

.form-input {
  background: #f8fafc;
  border: 1px solid #cbd5e1;
  border-radius: 10rpx;
  padding: 14rpx 20rpx;
  font-size: 26rpx;
  color: #0f172a;
}

.form-row-2 {
  display: flex;
  gap: 16rpx;
}

.flex-1 {
  flex: 1;
}

.size-hint-box {
  background: #eff6ff;
  color: #1d4ed8;
  padding: 14rpx 18rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  margin-bottom: 20rpx;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx 30rpx 30rpx;
}
