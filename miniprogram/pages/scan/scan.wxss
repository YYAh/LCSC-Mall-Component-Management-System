/* pages/scan/scan.wxss */
.scan-header {
  margin-bottom: 24rpx;
}

.scan-main-btn {
  font-size: 32rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(24, 144, 255, 0.35);
}

.scan-mode-hint {
  font-size: 22rpx;
  color: #52c41a;
  background: #f6ffed;
  border: 1px solid #b7eb8f;
  border-radius: 8rpx;
  padding: 10rpx 16rpx;
  margin: 16rpx 0;
  text-align: center;
}

.btn-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.manual-input-box {
  display: flex;
  gap: 16rpx;
}

.manual-input {
  flex: 1;
  background: #f8fafc;
  border: 1px solid #d9d9d9;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
}

.manual-btn {
  background: #1890ff;
  color: #ffffff;
  font-size: 26rpx;
  border-radius: 12rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Success Card */
.success-card {
  border: 2px solid #52c41a;
  background: #ffffff;
}

.success-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 20rpx;
  border-bottom: 1px solid #f0f0f0;
  margin-bottom: 20rpx;
}

.success-icon {
  font-size: 56rpx;
}

.success-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #52c41a;
}

.success-sub {
  font-size: 22rpx;
  color: #8c8c8c;
}

.comp-preview-header {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
  background: #f9fbfd;
  border-radius: 12rpx;
  padding: 20rpx;
}

.comp-img {
  width: 130rpx;
  height: 130rpx;
  background: #ffffff;
  border-radius: 10rpx;
  border: 1px solid #f0f0f0;
}

.comp-info-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
}

.no-img-layout {
  padding: 6rpx 0;
}

.comp-title-row {
  display: flex;
  gap: 12rpx;
}

.comp-mpn-bold {
  font-size: 34rpx;
  font-weight: 800;
  color: #1a1a1a;
  letter-spacing: 0.5rpx;
}

.mpn-extra-large {
  font-size: 40rpx;
  font-weight: 800;
  color: #1a1a1a;
  line-height: 1.3;
  margin: 6rpx 0;
}

.comp-name-sub {
  font-size: 24rpx;
  color: #595959;
}

.comp-name-input {
  font-size: 28rpx;
  padding: 6rpx 12rpx;
  margin: 6rpx 0;
}

.comp-tags {
  display: flex;
  gap: 10rpx;
}

.badge-brand {
  background: #f0f5ff;
  color: #2f54eb;
  border: 1px solid #adc6ff;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
}

.font-brand {
  color: #2f54eb;
  font-weight: 600;
}

/* Saved Info Grid */
.saved-info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}

.info-cell {
  display: flex;
  flex-direction: column;
}

.info-lbl {
  font-size: 22rpx;
  color: #8c8c8c;
}

.info-val {
  font-size: 26rpx;
  color: #262626;
  font-weight: 500;
  margin-top: 4rpx;
}

.info-val-bold {
  font-size: 34rpx;
  color: #1890ff;
  font-weight: 800;
}

.info-val-badge {
  font-size: 30rpx;
  color: #52c41a;
  font-weight: 800;
}

.success-actions {
  display: flex;
  gap: 16rpx;
}

.flex-1 {
  flex: 1;
}

/* Form Styles */
.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.picker-box {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
}

.picker-arrow {
  font-size: 20rpx;
  color: #8c8c8c;
}

.location-preview-banner {
  margin-top: 16rpx;
  background: #f6ffed;
  border: 1px dashed #b7eb8f;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
}

.badge-location-lg {
  font-size: 30rpx;
  font-weight: 700;
  color: #52c41a;
  background: #ffffff;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  border: 1px solid #b7eb8f;
}

.qty-input {
  font-size: 32rpx;
  font-weight: 700;
  color: #1890ff;
}

.footer-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.action-submit-btn { flex: 1; }
.action-print-btn { flex: 1.2; }

/* Candidate Modal */
.candidate-scroll-list {
  max-height: 55vh;
}

.candidate-item {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.candidate-item:active {
  background: #e6f7ff;
  border-color: #1890ff;
}

.candidate-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.candidate-brand {
  font-size: 22rpx;
  color: #2f54eb;
}

.candidate-mpn-bold {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.candidate-spec {
  font-size: 24rpx;
  color: #595959;
  margin-top: 4rpx;
}

.candidate-pkg {
  font-size: 22rpx;
  color: #8c8c8c;
  margin-top: 4rpx;
}
