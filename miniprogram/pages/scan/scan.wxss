/* pages/scan/scan.wxss */

/* ============================================== */
/* Pre-Scan Location Selector Card (扫码前预选仓位) */
/* ============================================== */
.pre-location-card {
  background: #ffffff;
  border: 1.5px solid #bfdbfe;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 14rpx rgba(37, 99, 235, 0.08);
}

.pre-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.pre-title-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.pre-title-icon {
  font-size: 28rpx;
}

.pre-card-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e3a8a;
}

.container-switch-btn {
  background: #eff6ff;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  border: 1px solid #bfdbfe;
}

.container-info-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1px dashed #e2e8f0;
}

.container-name-bold {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.container-code-badge {
  background: #f1f5f9;
  color: #475569;
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.container-type-tag {
  background: #fef3c7;
  color: #b45309;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.container-empty-tip {
  font-size: 20rpx;
  color: #16a34a;
  margin-left: auto;
  font-weight: 600;
}

.btn-quick-new-container {
  background: #f0fdf4 !important;
  color: #16a34a !important;
  border: 1px solid #bbf7d0 !important;
  font-size: 20rpx !important;
  font-weight: 700 !important;
  padding: 4rpx 14rpx !important;
  border-radius: 20rpx !important;
  margin: 0 !important;
  line-height: 1.4 !important;
}

/* Allocation Mode Tabs */
.alloc-mode-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.alloc-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 8rpx;
  background: #f8fafc;
  border: 1px solid #cbd5e1;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #64748b;
  transition: all 0.2s;
}

.alloc-tab.active {
  background: #eff6ff;
  border-color: #2563eb;
  color: #1d4ed8;
  font-weight: 700;
  box-shadow: 0 2rpx 6rpx rgba(37, 99, 235, 0.12);
}

/* Target Location Display Banner */
.target-location-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  transition: all 0.2s;
}

.banner-empty {
  background: #f0fdf4;
  border: 1.5px solid #86efac;
}

.banner-occupied {
  background: #fffbeb;
  border: 1.5px solid #fde68a;
}

.target-location-banner:active {
  opacity: 0.85;
}

.banner-left {
  flex: 1;
}

.target-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #475569;
}

.target-status-tag {
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.tag-free {
  background: #dcfce7;
  color: #15803d;
}

.tag-warn {
  background: #fee2e2;
  color: #b91c1c;
}

.target-coord-text {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 6rpx;
}

.coord-desc {
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
}

.highlight-coord {
  color: #2563eb;
  font-size: 34rpx;
}

.target-code-tag {
  background: #dbeafe;
  color: #1e40af;
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.occupied-hint {
  font-size: 20rpx;
  color: #b45309;
  margin-top: 6rpx;
}

.banner-right {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding-left: 14rpx;
}

.change-btn-text {
  font-size: 22rpx;
  color: #2563eb;
  font-weight: 600;
}

.arrow-icon {
  font-size: 20rpx;
  color: #2563eb;
}

/* ============================================== */
/* Scan Header & Buttons                          */
/* ============================================== */
.scan-header {
  margin-bottom: 24rpx;
}

.scan-main-btn {
  font-size: 32rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(24, 144, 255, 0.35);
}

.scan-mode-hint {
  font-size: 22rpx;
  color: #15803d;
  background: #f0fdf4;
  border: 1px solid #bbf7d0;
  border-radius: 8rpx;
  padding: 10rpx 16rpx;
  margin: 16rpx 0;
  text-align: center;
}

.btn-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.manual-input-box {
  display: flex;
  gap: 16rpx;
}

.manual-input {
  flex: 1;
  background: #f8fafc;
  border: 1px solid #d9d9d9;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
}

.manual-btn {
  background: #1890ff;
  color: #ffffff;
  font-size: 26rpx;
  border-radius: 12rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ============================================== */
/* Success Card                                   */
/* ============================================== */
.success-card {
  border: 2px solid #52c41a;
  background: #ffffff;
}

.success-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1px solid #f0f0f0;
}

.success-icon {
  font-size: 52rpx;
}

.success-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #52c41a;
}

.success-sub {
  font-size: 22rpx;
  color: #8c8c8c;
  margin-top: 4rpx;
}

.comp-preview-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.comp-img {
  width: 140rpx;
  height: 140rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  border: 1px solid #e8e8e8;
  flex-shrink: 0;
}

.comp-info-main {
  flex: 1;
}

.no-img-layout {
  width: 100%;
}

.comp-title-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.badge-category {
  background: #f6ffed;
  color: #52c41a;
  border: 1px solid #b7eb8f;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.badge-c-code {
  background: #e6f7ff;
  color: #1890ff;
  border: 1px solid #91d5ff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 700;
}

.comp-mpn-bold {
  font-size: 34rpx;
  font-weight: 800;
  color: #1a1a1a;
  line-height: 1.3;
  word-break: break-all;
}

.mpn-extra-large {
  font-size: 40rpx;
}

.comp-name-sub {
  font-size: 24rpx;
  color: #595959;
  margin-top: 6rpx;
}

.saved-info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  background: #f8fafc;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.info-cell {
  display: flex;
  flex-direction: column;
}

.info-lbl {
  font-size: 20rpx;
  color: #8c8c8c;
  margin-bottom: 4rpx;
}

.info-val {
  font-size: 26rpx;
  color: #262626;
}

.info-val-bold {
  font-size: 32rpx;
  font-weight: 700;
  color: #1890ff;
}

.info-val-badge {
  font-size: 24rpx;
  font-weight: 700;
  color: #52c41a;
  background: #f6ffed;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  align-self: flex-start;
}

.font-brand {
  font-weight: 600;
  color: #2f54eb;
}

.success-actions {
  display: flex;
  gap: 16rpx;
}

.flex-1 {
  flex: 1;
}

/* Manual Form */
.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.form-item {
  margin-bottom: 16rpx;
}

.form-label {
  font-size: 22rpx;
  color: #595959;
  margin-bottom: 6rpx;
}

.form-input {
  background: #f8fafc;
  border: 1px solid #d9d9d9;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
}

.form-location-badge {
  background: #eff6ff;
  border: 1px solid #93c5fd;
  color: #1d4ed8;
  font-size: 28rpx;
  font-weight: 700;
  padding: 14rpx 20rpx;
  border-radius: 8rpx;
  text-align: center;
}

.comp-tags {
  display: flex;
  gap: 10rpx;
  margin-top: 10rpx;
}

.badge-brand {
  background: #f0f5ff;
  color: #2f54eb;
  border: 1px solid #adc6ff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

/* ============================================== */
/* Interactive Matrix Grid Slot Picker Modal      */
/* ============================================== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
  padding: 30rpx;
}

.modal-card {
  background: #ffffff;
  border-radius: 20rpx;
  width: 100%;
  max-width: 650rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #f8fafc;
  border-bottom: 1px solid #e2e8f0;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.modal-close {
  font-size: 36rpx;
  color: #94a3b8;
  padding: 6rpx;
}

.modal-body {
  padding: 24rpx;
  max-height: 65vh;
  overflow-y: auto;
}

.picker-tip {
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 14rpx;
}

.picker-box-grid {
  display: grid;
  gap: 10rpx;
}

.picker-cell {
  border-radius: 10rpx;
  padding: 10rpx 6rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  min-height: 100rpx;
  transition: all 0.2s;
}

.p-empty {
  background: #f8fafc;
  border: 1px dashed #cbd5e1;
}

.p-empty:active {
  background: #ecfdf5;
  border-color: #10b981;
}

.p-occupied {
  background: #ffffff;
  border: 1px solid #93c5fd;
}

.p-selected {
  border: 2px solid #2563eb !important;
  background: #eff6ff !important;
  box-shadow: 0 0 10rpx rgba(37, 99, 235, 0.3);
}

.p-coord {
  font-size: 18rpx;
  font-weight: 700;
  color: #2563eb;
}

.p-status {
  font-size: 18rpx;
  color: #64748b;
  margin-top: 4rpx;
  word-break: break-all;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Book page/row picker */
.book-row-picker-box {
  padding: 10rpx 0;
}

.book-picker-row {
  display: flex;
  align-items: center;
}

.bp-lbl {
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
  width: 120rpx;
}

.bp-input {
  flex: 1;
  background: #f8fafc;
  border: 1px solid #cbd5e1;
  border-radius: 10rpx;
  padding: 14rpx 20rpx;
  font-size: 26rpx;
  color: #1e293b;
}

/* Candidates modal */
.candidate-item {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.candidate-row-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.candidate-c-code {
  background: #e6f7ff;
  color: #1890ff;
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.candidate-mpn {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
}

.candidate-name {
  font-size: 22rpx;
  color: #475569;
  margin-top: 4rpx;
}

.candidate-meta {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}
