/** app.wxss **/
page {
  background-color: #f4f6f9;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  color: #333333;
  font-size: 28rpx;
  box-sizing: border-box;
}

view, text, image, input, button {
  box-sizing: border-box;
}

/* Common Container */
.container {
  padding: 24rpx;
}

/* Card */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* Primary Button */
.btn-primary {
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #ffffff;
  font-weight: 500;
  border-radius: 40rpx;
  padding: 20rpx 36rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(24, 144, 255, 0.3);
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-success {
  background: linear-gradient(135deg, #52c41a, #389e0d);
  color: #ffffff;
  font-weight: 500;
  border-radius: 40rpx;
  padding: 20rpx 36rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-secondary {
  background: #f0f2f5;
  color: #595959;
  font-weight: 500;
  border-radius: 40rpx;
  padding: 18rpx 32rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

/* Tag Badges */
.badge-c-code {
  background: #e6f7ff;
  color: #1890ff;
  border: 1px solid #91d5ff;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge-location {
  background: #f6ffed;
  color: #52c41a;
  border: 1px solid #b7eb8f;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge-category {
  background: #fff7e6;
  color: #fa8c16;
  border: 1px solid #ffd591;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
}

.badge-danger {
  background: #fff1f0;
  color: #f5222d;
  border: 1px solid #ffa39e;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
}

/* Form Styles */
.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.form-input {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  color: #333333;
}

.form-input:focus {
  border-color: #1890ff;
  background: #ffffff;
}

/* Empty placeholder */
.empty-box {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #8c8c8c;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  display: block;
}

.empty-text {
  font-size: 28rpx;
  color: #8c8c8c;
}
